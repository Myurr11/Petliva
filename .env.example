EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Where Supabase sends people after they click the "confirm your email" link.
# Without this, Supabase falls back to the dashboard's Site URL (often left
# as the localhost default) and the link 404s / shows "can't connect" in the
# browser — the email still gets confirmed, it just looks broken.
# Host docs/email-confirmed.html somewhere (e.g. GitHub Pages) and put that
# URL here. It must also be added to Supabase → Authentication → URL
# Configuration → Redirect URLs, or Supabase will reject it.
EXPO_PUBLIC_EMAIL_CONFIRM_URL=https://your-username.github.io/your-repo/email-confirmed.html
